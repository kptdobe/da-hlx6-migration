{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListSourceBusTestSites",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::helix-source-bus",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "kptdobe/sample-content-hlx6/*",
            "kptdobe/sample-content-hlx6-migrated/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadSourceBusTestSites",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::helix-source-bus/kptdobe/sample-content-hlx6/*",
        "arn:aws:s3:::helix-source-bus/kptdobe/sample-content-hlx6-migrated/*"
      ]
    },
    {
      "Sid": "WriteSourceBusMigratedSite",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::helix-source-bus/kptdobe/sample-content-hlx6-migrated/*"
    },
    {
      "Sid": "ListMediaBusTestSites",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::helix-media-bus",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "cdb7c31a0884cd980ae35142093dbd9e12dd50a3ad8f106e472d50255a8/*",
            "8a228067304382d0717c282ae08947b512ada27852b0c144dc9ba0afce4/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadMediaBusTestSites",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::helix-media-bus/cdb7c31a0884cd980ae35142093dbd9e12dd50a3ad8f106e472d50255a8/*",
        "arn:aws:s3:::helix-media-bus/8a228067304382d0717c282ae08947b512ada27852b0c144dc9ba0afce4/*"
      ]
    },
    {
      "Sid": "WriteMediaBusMigratedSite",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::helix-media-bus/8a228067304382d0717c282ae08947b512ada27852b0c144dc9ba0afce4/*"
    },
    {
      "Sid": "ReadTestSiteConfigs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::helix-config-bus/orgs/kptdobe/sites/sample-content-da.json",
        "arn:aws:s3:::helix-config-bus/orgs/kptdobe/sites/sample-content-hlx6.json",
        "arn:aws:s3:::helix-config-bus/orgs/kptdobe/sites/sample-content-hlx6-migrated.json"
      ]
    },
    {
      "Sid": "NeverDeleteOrReconfigure",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutObjectAcl",
        "s3:PutObjectVersionAcl",
        "s3:PutBucket*",
        "s3:DeleteBucket*",
        "s3:PutLifecycleConfiguration",
        "s3:PutReplicationConfiguration",
        "s3:PutEncryptionConfiguration"
      ],
      "Resource": "*"
    }
  ]
}
