{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTargetSite",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::helix-source-bus",
      "Condition": {
        "StringLike": {
          "s3:prefix": "${aws:PrincipalTag/org}/${aws:PrincipalTag/hlx6-site}/*"
        }
      }
    },
    {
      "Sid": "ReadWriteTargetSite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::helix-source-bus/${aws:PrincipalTag/org}/${aws:PrincipalTag/hlx6-site}/*"
    },
    {
      "Sid": "ListMedia",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::helix-media-bus",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "${aws:PrincipalTag/da-content-bus-id}/*",
            "${aws:PrincipalTag/hlx6-content-bus-id}/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadDaSiteMedia",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::helix-media-bus/${aws:PrincipalTag/da-content-bus-id}/*"
    },
    {
      "Sid": "ReadWriteTargetMedia",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::helix-media-bus/${aws:PrincipalTag/hlx6-content-bus-id}/*"
    },
    {
      "Sid": "ReadSiteConfigs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::helix-config-bus/orgs/${aws:PrincipalTag/org}/sites/${aws:PrincipalTag/da-site}.json",
        "arn:aws:s3:::helix-config-bus/orgs/${aws:PrincipalTag/org}/sites/${aws:PrincipalTag/hlx6-site}.json"
      ]
    },
    {
      "Sid": "DenyWithoutOrg",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": { "Null": { "aws:PrincipalTag/org": "true" } }
    },
    {
      "Sid": "DenyWithoutSite",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": { "Null": { "aws:PrincipalTag/hlx6-site": "true" } }
    },
    {
      "Sid": "DenyWithoutTargetMedia",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": { "Null": { "aws:PrincipalTag/hlx6-content-bus-id": "true" } }
    },
    {
      "Sid": "NeverDeleteOrReconfigure",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutObjectAcl",
        "s3:PutObjectVersionAcl",
        "s3:PutBucket*",
        "s3:DeleteBucket*",
        "s3:PutLifecycleConfiguration",
        "s3:PutReplicationConfiguration",
        "s3:PutEncryptionConfiguration"
      ],
      "Resource": "*"
    }
  ]
}
