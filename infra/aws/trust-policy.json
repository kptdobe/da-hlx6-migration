{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeOnlyWithMigrationScope",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::118435662149:role/<OPERATOR_ROLE_ALLOWED_TO_RUN_MIGRATIONS>"
      },
      "Action": ["sts:AssumeRole", "sts:TagSession"],
      "Condition": {
        "Null": {
          "aws:RequestTag/org": "false",
          "aws:RequestTag/da-site": "false",
          "aws:RequestTag/hlx6-site": "false",
          "aws:RequestTag/da-content-bus-id": "false",
          "aws:RequestTag/hlx6-content-bus-id": "false"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["org", "da-site", "hlx6-site", "da-content-bus-id", "hlx6-content-bus-id"]
        },
        "StringNotLike": {
          "aws:RequestTag/org": "*/*",
          "aws:RequestTag/da-site": "*/*",
          "aws:RequestTag/hlx6-site": "*/*",
          "aws:RequestTag/da-content-bus-id": "*/*",
          "aws:RequestTag/hlx6-content-bus-id": "*/*"
        }
      }
    }
  ]
}
